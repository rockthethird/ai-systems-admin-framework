{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rockthethird/ai-systems-admin-framework/blob/master/modules/audit/reporting/schema/ai-auditor-findings-v1.schema.json",
  "title": "AI Auditor Findings Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "source", "analysis", "assessment", "summary", "findings"],
  "properties": {
    "schema_version": {"const": "ai-auditor-findings/v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventory_schema_version", "collected_at", "host"],
      "properties": {
        "inventory_schema_version": {"const": "1.0"},
        "collected_at": {"type": "string", "format": "date-time"},
        "host": {"type": "string", "minLength": 1},
        "inventory_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "prompt_version", "limitations"],
      "properties": {
        "engine": {"type": "string", "minLength": 1},
        "model": {"type": ["string", "null"]},
        "prompt_version": {"type": "string", "minLength": 1},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "assessment": {"$ref": "#/$defs/assessment"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "critical", "high", "medium", "low", "info"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "critical": {"type": "integer", "minimum": 0},
        "high": {"type": "integer", "minimum": 0},
        "medium": {"type": "integer", "minimum": 0},
        "low": {"type": "integer", "minimum": 0},
        "info": {"type": "integer", "minimum": 0}
      }
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    }
  },
  "$defs": {
    "assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["rules_evaluated", "passed", "failed", "unknown", "results"],
      "properties": {
        "rules_evaluated": {"type": "integer", "minimum": 1},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "unknown": {"type": "integer", "minimum": 0},
        "results": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "control", "section", "status", "summary"],
          "properties": {
            "id": {"type": "string", "pattern": "^AIA-[0-9]{4}$"},
            "control": {"type": "string", "minLength": 1},
            "section": {"type": "string", "minLength": 1},
            "status": {"enum": ["passed", "failed", "unknown"]},
            "summary": {"type": ["string", "null"]}
          }
        }}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "severity", "category", "status", "confidence", "sensitivity", "evidence", "rationale", "impact", "recommendation", "references"],
      "properties": {
        "id": {"type": "string", "pattern": "^AIA-[0-9]{4}$"},
        "title": {"type": "string", "minLength": 1},
        "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
        "category": {"type": "string", "minLength": 1},
        "status": {"enum": ["open", "accepted", "resolved", "not_applicable"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "sensitivity": {"enum": ["public", "internal", "confidential", "restricted"]},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["section", "path", "observation"],
            "properties": {
              "section": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "observation": {"type": "string", "minLength": 1}
            }
          }
        },
        "rationale": {"type": "string", "minLength": 1},
        "impact": {"type": "string", "minLength": 1},
        "recommendation": {"type": "string", "minLength": 1},
        "references": {"type": "array", "items": {"type": "string", "format": "uri"}, "uniqueItems": true}
      }
    }
  }
}
