{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["version", "defaults", "collectors"],
  "properties": {
    "version": {"const": "ai-auditor-collectors/v1"},
    "defaults": {
      "type": "object", "additionalProperties": false,
      "required": ["command_timeout_seconds", "max_items", "max_stream_bytes", "max_cpu_seconds", "max_open_files", "max_file_bytes"],
      "properties": {
        "command_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 60},
        "max_items": {"type": "integer", "minimum": 1, "maximum": 10000},
        "max_stream_bytes": {"type": "integer", "minimum": 1024, "maximum": 4194304},
        "max_cpu_seconds": {"type": "integer", "minimum": 1, "maximum": 30},
        "max_open_files": {"type": "integer", "minimum": 16, "maximum": 1024},
        "max_file_bytes": {"type": "integer", "minimum": 1024, "maximum": 4194304}
      }
    },
    "collectors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/collector"}}
  },
  "$defs": {
    "collector": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "type": {"enum": ["command", "builtin"]},
        "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/command"}},
        "parser": {"enum": ["lines"]},
        "primitive": {"enum": ["passwd-entries", "ssh-effective-settings", "account-path-metadata", "path-metadata"]},
        "parameters": {"type": "object"}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "command"}}}, "then": {"required": ["candidates", "parser"], "not": {"anyOf": [{"required": ["primitive"]}, {"required": ["parameters"]}]}}},
        {"if": {"properties": {"type": {"const": "builtin"}}}, "then": {"required": ["primitive"], "not": {"anyOf": [{"required": ["candidates"]}, {"required": ["parser"]}]}}}
      ]
    },
    "command": {
      "type": "object", "additionalProperties": false, "required": ["path", "args"],
      "properties": {
        "path": {"type": "string", "pattern": "^/[^\\u0000]*$"},
        "args": {"type": "array", "items": {"type": "string", "pattern": "^[^\\u0000]*$"}, "maxItems": 20}
      }
    }
  }
}
