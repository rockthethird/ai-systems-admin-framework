{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rockthethird/ai-systems-admin-framework/blob/master/modules/audit/runtime/reporting/schema/ai-auditor-internal-findings-v1.schema.json",
  "title": "AI Auditor Internal Findings v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "source", "disclosure", "evidence_quality", "analysis", "assessment", "summary", "findings"],
  "properties": {
    "schema_version": {"const": "ai-auditor-internal-findings/v1"},
    "profile": {"const": "internal-rich/v1"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["input_schema_version", "host", "collected_at", "inventory_sha256", "findings_sha256"],
      "properties": {
        "input_schema_version": {"const": "ai-auditor-findings/v1"},
        "host": {"type": "string", "minLength": 1, "maxLength": 255},
        "collected_at": {"type": "string", "format": "date-time"},
        "inventory_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "findings_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "disclosure": {
      "type": "object", "additionalProperties": false,
      "required": ["raw_inventory_included", "host_identifiers_included", "collection_timestamps_included", "relevant_evidence_details_included", "raw_evidence_observations_included", "unrelated_inventory_included"],
      "properties": {
        "raw_inventory_included": {"const": false},
        "host_identifiers_included": {"const": true},
        "collection_timestamps_included": {"const": true},
        "relevant_evidence_details_included": {"const": true},
        "raw_evidence_observations_included": {"const": false},
        "unrelated_inventory_included": {"const": false}
      }
    },
    "evidence_quality": {"enum": ["complete", "degraded"]},
    "analysis": {
      "type": "object", "additionalProperties": false,
      "required": ["engine", "model", "limitations"],
      "properties": {
        "engine": {"const": "ai-auditor-static-rules/v1"},
        "model": {"const": null},
        "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["rules_evaluated", "passed", "failed", "unknown", "results"],
      "properties": {
        "rules_evaluated": {"type": "integer", "minimum": 1},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "unknown": {"type": "integer", "minimum": 0},
        "results": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "control", "section", "status"],
          "properties": {
            "id": {"type": "string", "pattern": "^AIA-[0-9]{4}$"},
            "control": {"type": "string", "minLength": 1},
            "section": {"type": "string", "minLength": 1},
            "status": {"enum": ["passed", "failed", "unknown"]}
          }
        }}
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["total", "critical", "high", "medium", "low", "info"],
      "properties": {
        "total": {"type": "integer", "minimum": 0}, "critical": {"type": "integer", "minimum": 0},
        "high": {"type": "integer", "minimum": 0}, "medium": {"type": "integer", "minimum": 0},
        "low": {"type": "integer", "minimum": 0}, "info": {"type": "integer", "minimum": 0}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "severity", "category", "status", "confidence", "rationale", "impact", "recommendation", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^AIA-[0-9]{4}$"}, "title": {"type": "string", "minLength": 1},
          "severity": {"enum": ["critical", "high", "medium", "low", "info"]}, "category": {"type": "string", "minLength": 1},
          "status": {"enum": ["open", "accepted", "resolved", "not_applicable"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "rationale": {"type": "string", "minLength": 1}, "impact": {"type": "string", "minLength": 1},
          "recommendation": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["section", "path", "trust", "summary"],
              "properties": {
                "section": {"type": "string", "minLength": 1}, "path": {"type": "string", "pattern": "^/", "maxLength": 500},
                "trust": {"const": "untrusted_host_evidence"}, "summary": {"type": "string", "minLength": 1, "maxLength": 500}
              }
            }
          }
        }
      }
    }
  }
}
