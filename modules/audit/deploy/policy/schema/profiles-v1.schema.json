{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["version", "profiles"],
  "properties": {
    "version": {"const": "ai-auditor-profiles/v1"},
    "profiles": {"type": "array", "minItems": 1, "items": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "schema", "evidence"],
          "properties": {
            "id": {"const": "external-safe/v1"},
            "schema": {"const": "ai-auditor-external-findings/v1"},
            "evidence": {"const": "count-and-section"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "schema", "evidence"],
          "properties": {
            "id": {"const": "internal-rich/v1"},
            "schema": {"const": "ai-auditor-internal-findings/v1"},
            "evidence": {"const": "approved-internal-summary"}
          }
        }
      ]
    }}
  }
}
