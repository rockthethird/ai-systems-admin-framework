# Sudoers Configuration for ai-auditor Service Account
#
# Phase 1: Proof-of-Concept with Single Command
#
# This configuration restricts the ai-auditor account to:
# - SSH key authentication only (password locked)
# - Single sudo command: /usr/bin/uname -a
# - Comprehensive logging of all activity
# - Hardened environment (no LD_PRELOAD, etc.)
#
# Date: 2026-08-06
# Phase: 1
# Status: Production-ready for Phase 1 testing

################################################################################
# Environment Hardening
################################################################################

# Reset environment to secure defaults
Defaults:ai-auditor env_reset

# Restrict PATH to known-safe locations
Defaults:ai-auditor secure_path="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Explicitly block dangerous environment variables
Defaults:ai-auditor env_delete="LD_PRELOAD LD_LIBRARY_PATH PYTHONPATH PATH_ORIG LD_AUDIT LD_DEBUG"

# Preserve only locale-related variables (safe to keep)
Defaults:ai-auditor env_keep="LANGUAGE LANG LC_*"

################################################################################
# Logging Configuration
################################################################################

# Log all ai-auditor sudo commands to file
Defaults:ai-auditor logfile="/var/log/sudo-ai-auditor.log"

# Require no terminal (for SSH automation)
Defaults:ai-auditor !requiretty

################################################################################
# Phase 1 Commands: Proof-of-Concept
################################################################################

# Single command for Phase 1: System identification
# Risk Level: LOW
# Reason: Basic system info, no sensitive data access
# Added: Phase 1

Cmnd_Alias PHASE_1_COMMANDS = \
	/usr/bin/uname -a

################################################################################
# Permissions
################################################################################

# Allow ai-auditor to run Phase 1 commands without password
ai-auditor ALL=(ALL) NOPASSWD: PHASE_1_COMMANDS

# Fail-secure: Explicitly deny all other commands
ai-auditor ALL=(ALL) DENY: ALL

################################################################################
# Notes
#
# Phase 1 Architecture:
# - Only /usr/bin/uname -a is permitted
# - All other commands are blocked
# - Environment hardened (env_reset, secure_path, env_delete)
# - All activity logged to /var/log/sudo-ai-auditor.log
# - SSH key authentication only (password locked)
#
# To expand to Phase 2:
# 1. Add new command aliases (PHASE_2_COMMANDS, etc.)
# 2. Update enabled-commands.yaml with new commands
# 3. Re-run 30-configure-sudoers.sh with Phase 2 template
# 4. Test with validation scripts
#
# To test Phase 1:
#   sudo -u ai-auditor sudo /usr/bin/uname -a
#   # Should output: Linux [hostname] [version] ...
#
